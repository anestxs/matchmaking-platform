# Frontend URL
FRONTEND_URL=YOUR_FRONTEND_URL

# Database and Redis configuration
DATABASE_URL=YOUR_DATABASE_URL
REDIS_URL=YOUR_REDIS_URL

# JWT configuration
JWT_ACCESS_SECRET=YOUR_JWT_ACCESS_SECRET
JWT_ACCESS_TTL=YOUR_JWT_ACCESS_TIME_EXPIRATION
JWT_REFRESH_SECRET=YOUR_JWT_REFRESH_SECRET
JWT_REFRESH_TTL=YOUR_JWT_REFRESH_TIME_EXPIRATION
JWT_LINK_SECRET=YOUR_JWT_LINK_SECRET
JWT_LINK_TTL=YOUR_JWT_LINK_TIME_EXPIRATION

# Discord OAuth configuration
DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET
DISCORD_CALLBACK_URL=YOUR_DISCORD_CALLBACK_URL
DISCORD_LINK_CALLBACK_URL=YOUR_DISCORD_LINK_CALLBACK_URL

# Mail configuration
SMTP_HOST=YOUR_SMTP_HOST
SMTP_PORT=YOUR_SMTP_PORT
MAIL_FROM=YOUR_MAIL_FROM_ADDRESS

# One-time email token expiration, in seconds
EMAIL_VERIFICATION_TTL=YOUR_EMAIL_VERIFICATION_TIME_EXPIRATION
PASSWORD_RESET_TTL=YOUR_PASSWORD_RESET_TIME_EXPIRATION